# ══════════════════════════════════════════════════════════════════════════════
# RouteXia Backend — Environment Variables Template
# ══════════════════════════════════════════════════════════════════════════════
# SECURITY: Copy this file to ".env" and fill in real values.
#           NEVER commit the actual .env file to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/routexia

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production

# ── Admin Seed ────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@routexia.com
ADMIN_PASSWORD=change_this_admin_password

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Service Accounts
#                 → Generate New Private Key → download JSON file
#
# Option A (recommended for cloud: Render, Railway, Docker env vars)
FIREBASE_PROJECT_ID=routexia-3585f
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-XXXX@routexia-3585f.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nPASTE_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"

# Option B (alternative: path to downloaded service-account JSON file)
# FIREBASE_SERVICE_ACCOUNT_PATH=/etc/routexia/firebase-service-account.json

# ── Port ──────────────────────────────────────────────────────────────────────
PORT=8080
