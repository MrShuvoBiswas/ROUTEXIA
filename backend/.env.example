# RouteXia NestJS Backend Configuration

# Server Port
PORT=8080

# Neon DB Serverless PostgreSQL Connection String
# Paste your Neon DB connection string below:
DATABASE_URL=postgres://neondb_owner:npg_sample_pass@ep-routexia-db.ap-southeast-1.aws.neon.tech/routexia?sslmode=require

# JWT Secret Key
JWT_SECRET=RouteXia_Super_Secret_JWT_Key_2026_Enterprise!

# Default Admin Credentials (Seeded on first startup)
