# ══════════════════════════════════════════════════════════════════════════════
# RouteXia Client Open-Source Repository — .gitignore
# Excludes backend, web, databases, builds, and sensitive secrets
# ══════════════════════════════════════════════════════════════════════════════

# ── 1. Private Services & Admin Portals (DO NOT PUSH TO CLIENT REPO) ─────────
backend/
web/
server/
docs/
specs/
.specify/
.agents/

# ── 2. Secrets & Environment Files ───────────────────────────────────────────
*.env
*.env.*
*.env.local
*.env.production
firebase.config.json
firebase-service-account.json
**/firebase-service-account.json

# ── 3. Databases & Cache ─────────────────────────────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm
routexia.db

# ── 4. Build Artifacts & Binaries ────────────────────────────────────────────
artifacts/
**/artifacts/
*.nupkg
*.zip
*.pdb
**/.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# ── 5. .NET Compilation & Publish Outputs ────────────────────────────────────
**/[Bb]in/
**/[Oo]bj/
**/publish/
**/publish_*/

# ── 6. Node.js & Temporary Files ─────────────────────────────────────────────
**/node_modules/
**/dist/
.DS_Store
Thumbs.db