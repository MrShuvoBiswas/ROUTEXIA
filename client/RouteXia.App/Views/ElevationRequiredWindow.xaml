<Window
    x:Class="RouteXia.App.Views.ElevationRequiredWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="ROUTEXIA — Elevation Required"
    Width="520"
    Height="380"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="NoResize"
    Background="{StaticResource BgBaseBrush}"
    AllowsTransparency="False">

    <Border
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        Background="{StaticResource BgBaseBrush}">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ── Header ──────────────────────────────────────────────── -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Border
                    Width="40"
                    Height="40"
                    Background="{StaticResource AccentGlowBrush}"
                    CornerRadius="{StaticResource RadiusMd}"
                    Margin="0,0,14,0">
                    <ui:SymbolIcon
                        Symbol="Shield24"
                        FontSize="22"
                        Foreground="{StaticResource AccentBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        Text="ELEVATION REQUIRED"
                        Style="{StaticResource HeadingLStyle}"
                        FontSize="18" />
                    <TextBlock
                        Text="Kernel Network Driver Permissions"
                        Style="{StaticResource CaptionStyle}"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- ── Body Content ────────────────────────────────────────── -->
            <Border
                Grid.Row="1"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMd}"
                Padding="16"
                Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock
                        Text="RouteXia uses the low-level WinDivert kernel filter driver to intercept and optimize game UDP packets in real-time."
                        Style="{StaticResource CaptionStyle}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        TextWrapping="Wrap"
                        LineHeight="18" />

                    <TextBlock
                        Text="Windows requires Administrator privileges to load kernel network drivers. Without elevation, RouteXia cannot intercept game traffic or activate the multipath routing engine."
                        Style="{StaticResource CaptionStyle}"
                        Foreground="{StaticResource TextMutedBrush}"
                        TextWrapping="Wrap"
                        Margin="0,10,0,0"
                        LineHeight="18" />

                    <Border
                        Margin="0,14,0,0"
                        Padding="10,6"
                        Background="{StaticResource BgPanelBrush}"
                        CornerRadius="{StaticResource RadiusXs}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Symbol="Info24"
                                FontSize="14"
                                Foreground="{StaticResource AccentBrush}"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="DiagnosticTextBlock"
                                Text="Click below to grant UAC administrator privileges."
                                Style="{StaticResource CaptionStyle}"
                                Foreground="{StaticResource TextMutedBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ── Footer Actions ──────────────────────────────────────── -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="1"
                    Content="Exit"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="16,6"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="BtnExit_Click" />

                <Button
                    Grid.Column="2"
                    Content="🛡️ Relaunch as Admin"
                    Style="{StaticResource ConnectButtonStyle}"
                    Padding="18,6"
                    Height="36"
                    Click="BtnRelaunch_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
