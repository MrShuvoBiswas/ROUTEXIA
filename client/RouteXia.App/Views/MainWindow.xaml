<?xml version="1.0" encoding="utf-8"?>
<ui:FluentWindow
    x:Class="RouteXia.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:RouteXia.App.Views"
    Title="RouteXia"
    Width="900"
    Height="620"
    MinWidth="800"
    MinHeight="580"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    Background="{StaticResource BgBaseBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Title bar -->
            <RowDefinition Height="*" />
            <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <ui:TitleBar
            Grid.Row="0"
            Title="RouteXia"
            Icon="pack://application:,,,/Resources/Icons/routexia.ico"
            ShowMaximize="False"
            Background="Transparent">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <!-- Logo text -->
                    <TextBlock
                        Text="ROUTE"
                        FontFamily="/Resources/Fonts/#Rajdhani"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="{StaticResource AccentBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="XIA"
                        FontFamily="/Resources/Fonts/#Rajdhani"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left sidebar nav -->
                <ColumnDefinition Width="200" />
                <!-- Main content -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Sidebar -->
            <Border
                Grid.Column="0"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
                <StackPanel Margin="0,24,0,0">

                    <!-- Nav: Connect -->
                    <Button
                        x:Name="BtnNavConnect"
                        Style="{StaticResource NavButtonStyle}"
                        Click="BtnNavConnect_Click"
                        Tag="active">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Globe32" FontSize="18" Margin="0,0,12,0" />
                            <TextBlock Text="Connect" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Nav: Account / Subscription -->
                    <Button
                        x:Name="BtnNavAccount"
                        Style="{StaticResource NavButtonStyle}"
                        Click="BtnNavAccount_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Person32" FontSize="18" Margin="0,0,12,0" />
                            <TextBlock Text="Account" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Nav: Settings -->
                    <Button
                        x:Name="BtnNavSettings"
                        Style="{StaticResource NavButtonStyle}"
                        Click="BtnNavSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings32" FontSize="18" Margin="0,0,12,0" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Spacer -->
                    <Rectangle Height="1" Margin="16,16" Fill="{StaticResource BorderBrush}" />

                    <!-- App version -->
                    <TextBlock
                        Text="v0.1.0-beta"
                        FontSize="11"
                        Foreground="{StaticResource TextMutedBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,8" />
                </StackPanel>
            </Border>

            <!-- Content Frame -->
            <Frame
                x:Name="MainFrame"
                Grid.Column="1"
                NavigationUIVisibility="Hidden"
                Background="Transparent" />
        </Grid>
    </Grid>
</ui:FluentWindow>
