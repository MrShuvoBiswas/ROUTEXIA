<?xml version="1.0" encoding="utf-8"?>
<ui:FluentWindow
    x:Class="RouteXia.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="RouteXia"
    Width="1200"
    Height="760"
    MinWidth="1080"
    MinHeight="680"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    Background="{StaticResource BgBaseBrush}"
    Closing="MainWindow_Closing">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="188" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Background="{StaticResource BgSidebarBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,22,20,24">
                    <TextBlock
                        Text="ROUTEXIA"
                        Style="{StaticResource HeadingXLStyle}" />
                    <Border
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0"
                        Padding="8,3"
                        Background="{StaticResource NavActiveBgBrush}"
                        CornerRadius="{StaticResource RadiusXs}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            Text="{Binding ActiveRouteLabel, FallbackValue='SG ROUTE'}"
                            Style="{StaticResource BadgeLabelStyle}"
                            Foreground="{StaticResource AccentBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,18">
                    <Button
                        x:Name="BtnNavHome"
                        Style="{StaticResource NavButtonStyle}"
                        Tag="active"
                        Click="BtnNavHome_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Symbol="Rocket24"
                                FontSize="18"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Margin="0,0,12,0" />
                            <TextBlock
                                Text="Boost"
                                FontWeight="SemiBold"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="BtnNavNetwork"
                        Style="{StaticResource NavButtonStyle}"
                        Click="BtnNavNetwork_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Symbol="ShieldCheckmark24"
                                FontSize="18"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Margin="0,0,12,0" />
                            <TextBlock
                                Text="Protection"
                                FontWeight="SemiBold"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="BtnNavSettings"
                        Style="{StaticResource NavButtonStyle}"
                        Click="BtnNavSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Symbol="Settings24"
                                FontSize="18"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Margin="0,0,12,0" />
                            <TextBlock
                                Text="Settings"
                                FontWeight="SemiBold"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="BtnNavAccount"
                        Style="{StaticResource NavButtonStyle}"
                        Click="BtnNavAccount_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Symbol="Person24"
                                FontSize="18"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Margin="0,0,12,0" />
                            <TextBlock
                                Text="Account"
                                FontWeight="SemiBold"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="BtnNavHelp"
                        Style="{StaticResource NavButtonStyle}"
                        Click="BtnNavHelp_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Symbol="QuestionCircle24"
                                FontSize="18"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Margin="0,0,12,0" />
                            <TextBlock
                                Text="Help"
                                FontWeight="SemiBold"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- ── Game Detection Indicator (T031, T032, T033) ──────── -->
                <Border
                    x:Name="GameDetectionIndicator"
                    Grid.Row="2"
                    Margin="16,0,16,14"
                    Padding="12,10"
                    CornerRadius="{StaticResource RadiusMd}"
                    BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGameDetected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource StatusGoodBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsGameDetected}" Value="False">
                                    <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Game Icon with Fallback (T033) -->
                        <Grid Grid.Column="0" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                            <!-- Generic Fallback SymbolIcon -->
                            <ui:SymbolIcon
                                x:Name="FallbackGameIcon"
                                Symbol="Games24"
                                FontSize="18"
                                Foreground="{StaticResource AccentBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <!-- Game Image Icon -->
                            <Image
                                x:Name="GameIconImage"
                                Source="{Binding DetectedGameIconPath}"
                                Stretch="Uniform"
                                RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DetectedGameIconPath}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Grid>

                        <!-- Game Name & Status (T031, T032) -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                Text="ACTIVE GAME"
                                Style="{StaticResource CaptionStyle}"
                                Foreground="{StaticResource TextMutedBrush}"
                                FontSize="10"
                                FontWeight="Bold" />
                            <TextBlock
                                Text="{Binding DetectedGameName, FallbackValue='PUBG: Battlegrounds'}"
                                FontSize="12"
                                TextTrimming="CharacterEllipsis"
                                Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HeadingSmStyle}">
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGameDetected}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Status Dot Indicator (T031, T032) -->
                        <Ellipse
                            Grid.Column="2"
                            Width="8"
                            Height="8"
                            VerticalAlignment="Center"
                            Margin="4,0,0,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGameDetected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource StatusGoodBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="3"
                    Margin="20,0,20,22"
                    Padding="12"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}">
                    <StackPanel>
                        <TextBlock
                            Text="Ready for match"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock
                            Text="SG route active when boosted"
                            Margin="0,4,0,0"
                            FontSize="11"
                            Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                x:Name="TopBar"
                Grid.Row="0"
                Background="{StaticResource TopBarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid Margin="24,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                        <ui:SymbolIcon
                            Symbol="Pulse24"
                            FontSize="18"
                            Margin="0,0,10,0">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource StatusGoodBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsKillSwitchActive}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource StatusBadBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                        <TextBlock
                            Text="{Binding DetectedGameName, FallbackValue='RouteXia ready'}"
                            Style="{StaticResource HeadingSmStyle}" />
                        <Border
                            Margin="12,0,0,0"
                            Padding="8,3"
                            Background="{StaticResource BadgeBgBrush}"
                            CornerRadius="{StaticResource RadiusXs}">
                            <TextBlock
                                Text="BETA"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                        <Button
                            x:Name="BtnMinimize"
                            Width="36"
                            Height="30"
                            Margin="0,0,6,0"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnMinimize_Click">
                            <TextBlock
                                Text="-"
                                FontSize="18"
                                Foreground="{StaticResource TextMutedBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Button>
                        <Button
                            x:Name="BtnClose"
                            Width="36"
                            Height="30"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnClose_Click">
                            <TextBlock
                                Text="X"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="{StaticResource TextMutedBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Frame
                x:Name="MainFrame"
                Grid.Row="1"
                NavigationUIVisibility="Hidden"
                Background="{StaticResource BgBaseBrush}" />
        </Grid>

        <Border
            x:Name="ClosingOverlay"
            Grid.ColumnSpan="2"
            Visibility="Collapsed"
            Opacity="0"
            Background="{StaticResource OverlayDimBrush}"
            Panel.ZIndex="99">
            <Grid>
                <Grid
                    Width="72"
                    Height="72"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Ellipse
                        Stroke="{StaticResource BorderBrush}"
                        StrokeThickness="6" />
                    <Path
                        Stroke="{StaticResource AccentBrush}"
                        StrokeThickness="6"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        Data="M36,4 A32,32 0 0 1 68,36">
                        <Path.RenderTransform>
                            <RotateTransform
                                x:Name="ClosingSpinnerTransform"
                                CenterX="36"
                                CenterY="36" />
                        </Path.RenderTransform>
                    </Path>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
