<UserControl
    x:Class="RouteXia.App.Views.LatencyGraphControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    MinHeight="180"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Header / Legend ──────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon
                    Symbol="DataTrending24"
                    FontSize="16"
                    Foreground="{StaticResource AccentBrush}"
                    Margin="0,0,8,0" />
                <TextBlock
                    Text="REAL-TIME ROUTE LATENCY"
                    Style="{StaticResource HeadingSmStyle}"
                    VerticalAlignment="Center" />
                <Border
                    Margin="10,0,0,0"
                    Padding="6,2"
                    Background="{StaticResource BadgeBgBrush}"
                    CornerRadius="{StaticResource RadiusXs}">
                    <TextBlock
                        Text="60s WINDOW"
                        FontSize="9"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextMutedBrush}" />
                </Border>
            </StackPanel>

            <!-- Route Legends -->
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                    <Rectangle
                        Width="12"
                        Height="3"
                        RadiusX="1"
                        RadiusY="1"
                        Fill="{StaticResource AccentBrush}"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="Primary (SG)"
                        Style="{StaticResource CaptionStyle}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Rectangle
                        Width="12"
                        Height="3"
                        RadiusX="1"
                        RadiusY="1"
                        Fill="{StaticResource StatusWarnBrush}"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="Standby (IN)"
                        Style="{StaticResource CaptionStyle}"
                        Foreground="{StaticResource TextMutedBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ── Graph Body ───────────────────────────────────────────── -->
        <Border
            Grid.Row="1"
            Background="{StaticResource BgCardBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}"
            Padding="14,10,14,14"
            ClipToBounds="True">
            <Grid>
                <!-- Reference Grid Lines (Y-Axis) -->
                <Grid x:Name="GridLinesContainer">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 150ms Reference -->
                    <Grid Grid.Row="0" VerticalAlignment="Top">
                        <Line
                            X1="0" Y1="0"
                            X2="10000" Y2="0"
                            Stroke="{StaticResource BorderBrush}"
                            StrokeThickness="1"
                            StrokeDashArray="4 4" />
                        <TextBlock
                            Text="150 ms"
                            Style="{StaticResource CaptionStyle}"
                            Foreground="{StaticResource TextMutedBrush}"
                            HorizontalAlignment="Right"
                            Margin="0,-8,0,0" />
                    </Grid>

                    <!-- 100ms Reference -->
                    <Grid Grid.Row="1" VerticalAlignment="Top">
                        <Line
                            X1="0" Y1="0"
                            X2="10000" Y2="0"
                            Stroke="{StaticResource BorderBrush}"
                            StrokeThickness="1"
                            StrokeDashArray="4 4" />
                        <TextBlock
                            Text="100 ms"
                            Style="{StaticResource CaptionStyle}"
                            Foreground="{StaticResource TextMutedBrush}"
                            HorizontalAlignment="Right"
                            Margin="0,-8,0,0" />
                    </Grid>

                    <!-- 50ms Reference -->
                    <Grid Grid.Row="2" VerticalAlignment="Top">
                        <Line
                            X1="0" Y1="0"
                            X2="10000" Y2="0"
                            Stroke="{StaticResource BorderBrush}"
                            StrokeThickness="1"
                            StrokeDashArray="4 4" />
                        <TextBlock
                            Text="50 ms"
                            Style="{StaticResource CaptionStyle}"
                            Foreground="{StaticResource TextMutedBrush}"
                            HorizontalAlignment="Right"
                            Margin="0,-8,0,0" />
                    </Grid>

                    <!-- 0ms baseline -->
                    <Grid Grid.Row="3">
                        <Line
                            X1="0" Y1="0"
                            X2="10000" Y2="0"
                            Stroke="{StaticResource BorderBrush}"
                            StrokeThickness="1" />
                    </Grid>
                </Grid>

                <!-- Active Polyline Graph Canvas -->
                <Canvas
                    x:Name="GraphCanvas"
                    ClipToBounds="True"
                    SizeChanged="GraphCanvas_SizeChanged" />

                <!-- Disconnected / Empty Placeholder -->
                <Border
                    x:Name="PlaceholderOverlay"
                    Background="{StaticResource BgCardBrush}"
                    Visibility="Collapsed">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <ui:SymbolIcon
                            Symbol="Pulse24"
                            FontSize="32"
                            Foreground="{StaticResource ComingSoonBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,8" />
                        <TextBlock
                            Text="Connect to see live multipath latency"
                            Style="{StaticResource CaptionStyle}"
                            FontSize="12"
                            Foreground="{StaticResource TextMutedBrush}"
                            HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
