<Page
    x:Class="RouteXia.App.Views.SpeedTestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:RouteXia.App.ViewModels"
    Background="{StaticResource BgBaseBrush}"
    Title="Latency Benchmark">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,24,32,32" MaxWidth="850">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock
                        Text="Global Latency Benchmark"
                        FontFamily="/Resources/Fonts/#Rajdhani"
                        FontSize="26"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock
                        Text="Measure real-time round-trip latency to global RouteXia relay nodes and game server clusters"
                        FontSize="12"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="0,2,0,0" />
                </StackPanel>

                <!-- Run Benchmark Button -->
                <ui:Button
                    x:Name="BtnRunTest"
                    Grid.Column="1"
                    Click="BtnRunTest_Click"
                    Background="#0D1929"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,8"
                    Cursor="Hand"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Play24" FontSize="16" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="START BENCHMARK" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>
            </Grid>

            <!-- Optimal Recommendation Banner -->
            <Border
                Grid.Row="1"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20,16"
                Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="RECOMMENDED OPTIMAL REGION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding BestRegionText}" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="20" FontWeight="Bold" Foreground="{StaticResource StatusGoodBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#0D2A1A" BorderBrush="{StaticResource StatusGoodBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                        <TextBlock Text="LOWEST PING ROUTE" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="11" FontWeight="Bold" Foreground="{StaticResource StatusGoodBrush}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Region Nodes Grid -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding RegionNodes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RegionLatencyResult}">
                        <Border
                            Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18,16"
                            Margin="0,0,14,14"
                            Width="250">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Flag}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding RegionName}" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2" Background="#121D2B" CornerRadius="6" Padding="6,2">
                                        <TextBlock Text="{Binding RegionCode}" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Status}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" />
                                    <TextBlock Grid.Column="1" Text="{Binding PingDisplayText}" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="26" FontWeight="Bold" Foreground="{StaticResource StatusGoodBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</Page>
