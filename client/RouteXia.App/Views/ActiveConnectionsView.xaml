<Page
    x:Class="RouteXia.App.Views.ActiveConnectionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:data="clr-namespace:RouteXia.App.Data"
    xmlns:vm="clr-namespace:RouteXia.App.ViewModels"
    Background="#05070B"
    Title="Active Connections">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,20,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Top Live Telemetry Stats Bar -->
                <RowDefinition Height="*" />    <!-- Active Connections Table or Standby State -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock
                            Text="Connections &amp; Live Traffic"
                            FontFamily="/Resources/Fonts/#Rajdhani"
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="#FFFFFF"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0" />
                        <Border
                            Background="#091A14"
                            BorderBrush="#2ED573"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,3"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#2ED573" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="TELEMETRY LIVE" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="10" FontWeight="Bold" Foreground="#2ED573" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock
                        Text="Real-time multi-stream packet telemetry, game server endpoints, and live bandwidth usage"
                        FontSize="12"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="0,3,0,0" />
                </StackPanel>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button
                        Click="BtnBrowseGames_Click"
                        Background="#0D1929"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,7"
                        Cursor="Hand"
                        Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" FontSize="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Add Game" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button
                        Click="BtnRefresh_Click"
                        Background="#0B121C"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,7"
                        Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Refresh" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!-- 2. Top Live Telemetry Stats Bar -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card 1: Active Gateway Server -->
                <Border Grid.Column="0" Background="#090E16" BorderBrush="#162536" BorderThickness="1" CornerRadius="10" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="Globe24" FontSize="16" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="ACTIVE RELAY GATEWAY" FontSize="10" FontWeight="Bold" Foreground="#6B8095" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding RouteXiaServerText}" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="BGP Dynamic Multipath" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Card 2: Live Ping & Latency -->
                <Border Grid.Column="2" Background="#090E16" BorderBrush="#162536" BorderThickness="1" CornerRadius="10" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="Pulse24" FontSize="16" Foreground="#2ED573" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="ESTIMATED LATENCY" FontSize="10" FontWeight="Bold" Foreground="#6B8095" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding LivePingText}" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="18" FontWeight="Bold" Foreground="#2ED573" />
                        <TextBlock Text="0.0% Packet Loss • Stable" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Card 3: Live Upload Traffic -->
                <Border Grid.Column="4" Background="#090E16" BorderBrush="#162536" BorderThickness="1" CornerRadius="10" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="16" Foreground="#00C2FF" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="SENT TRAFFIC" FontSize="10" FontWeight="Bold" Foreground="#6B8095" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding SentRateKbpsText}" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="18" FontWeight="Bold" Foreground="#00C2FF" />
                        <TextBlock Text="{Binding SentTotalKbText, StringFormat='Total: {0}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Card 4: Live Download Traffic -->
                <Border Grid.Column="6" Background="#090E16" BorderBrush="#162536" BorderThickness="1" CornerRadius="10" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Foreground="#FFB020" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="RECEIVED TRAFFIC" FontSize="10" FontWeight="Bold" Foreground="#6B8095" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding RecvRateKbpsText}" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="18" FontWeight="Bold" Foreground="#FFB020" />
                        <TextBlock Text="{Binding RecvTotalKbText, StringFormat='Total: {0}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Active Connections Table Area -->
            <Border
                Grid.Row="2"
                Background="#070C12"
                BorderBrush="#152232"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Table Title -->
                        <RowDefinition Height="Auto" /> <!-- Table Headers -->
                        <RowDefinition Height="*" />    <!-- Table Rows / Standby Banner -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="ACTIVE NETWORK TUNNELS" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding GameStatusText}" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Table Column Headers -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" /> <!-- Application -->
                            <ColumnDefinition Width="160" /> <!-- RouteXia Server -->
                            <ColumnDefinition Width="200" /> <!-- Game Server IP -->
                            <ColumnDefinition Width="100" /> <!-- Protocol -->
                            <ColumnDefinition Width="130" /> <!-- Sent -->
                            <ColumnDefinition Width="130" /> <!-- Received -->
                            <ColumnDefinition Width="100" /> <!-- Ping -->
                            <ColumnDefinition Width="*" />   <!-- Action / Status -->
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Application" FontSize="11" FontWeight="Bold" Foreground="#5A6E82" />
                        <TextBlock Grid.Column="1" Text="RouteXia Server" FontSize="11" FontWeight="Bold" Foreground="#5A6E82" />
                        <TextBlock Grid.Column="2" Text="Game Server / Endpoint" FontSize="11" FontWeight="Bold" Foreground="#5A6E82" />
                        <TextBlock Grid.Column="3" Text="Protocol" FontSize="11" FontWeight="Bold" Foreground="#5A6E82" />
                        <TextBlock Grid.Column="4" Text="Sent (Rate / Total)" FontSize="11" FontWeight="Bold" Foreground="#5A6E82" />
                        <TextBlock Grid.Column="5" Text="Recv (Rate / Total)" FontSize="11" FontWeight="Bold" Foreground="#5A6E82" />
                        <TextBlock Grid.Column="6" Text="Live Ping" FontSize="11" FontWeight="Bold" Foreground="#5A6E82" />
                        <TextBlock Grid.Column="7" Text="Status" FontSize="11" FontWeight="Bold" Foreground="#5A6E82" HorizontalAlignment="Right" Margin="0,0,10,0" />
                    </Grid>

                    <!-- Table Live Data Row -->
                    <Border Grid.Row="2" Background="#0A111A" BorderBrush="#1A2D40" BorderThickness="1" CornerRadius="8" Padding="14,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" /> <!-- Application -->
                                <ColumnDefinition Width="160" /> <!-- RouteXia Server -->
                                <ColumnDefinition Width="200" /> <!-- Game Server IP -->
                                <ColumnDefinition Width="100" /> <!-- Protocol -->
                                <ColumnDefinition Width="130" /> <!-- Sent -->
                                <ColumnDefinition Width="130" /> <!-- Received -->
                                <ColumnDefinition Width="100" /> <!-- Ping -->
                                <ColumnDefinition Width="*" />   <!-- Action / Status -->
                            </Grid.ColumnDefinitions>

                            <!-- 1. Application Name & Icon -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="6" Background="#0E1825" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Image Source="{Binding CurrentGame.ImagePath}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentGame.Name}" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <TextBlock Text="Multipath Gaming Process" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 2. RouteXia Server -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RouteXiaServerText}" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock Text="Optimized Gateway" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>

                            <!-- 3. Game Server IP -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GameServerEndpointText}" FontFamily="/Resources/Fonts/#JetBrains Mono" FontSize="11" Foreground="#8FA5BD" LineHeight="15" />
                            </StackPanel>

                            <!-- 4. Protocol -->
                            <Border Grid.Column="3" Background="#0C1B2E" BorderBrush="#00C2FF" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="UDP Multipath" FontSize="10" FontWeight="Bold" Foreground="#00C2FF" />
                            </Border>

                            <!-- 5. Sent -->
                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SentRateKbpsText}" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock Text="{Binding SentTotalKbText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>

                            <!-- 6. Received -->
                            <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RecvRateKbpsText}" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock Text="{Binding RecvTotalKbText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>

                            <!-- 7. Ping -->
                            <Border Grid.Column="6" Background="#091A14" BorderBrush="#2ED573" BorderThickness="1" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LivePingText}" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="13" FontWeight="Bold" Foreground="#2ED573" />
                            </Border>

                            <!-- 8. Status -->
                            <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Border Background="#091A14" BorderBrush="#2ED573" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#2ED573" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="ROUTING ACTIVE" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="10" FontWeight="Bold" Foreground="#2ED573" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <ui:Button
                                    Click="BtnOpenOptimize_Click"
                                    Background="#0B131E"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,5"
                                    Cursor="Hand">
                                    <TextBlock Text="Routes" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Standby Banner (Visible when disconnected) -->
                    <Border Grid.Row="2" Background="#0A111A" BorderBrush="#1A2D40" BorderThickness="1" CornerRadius="8" Padding="14,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="20" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="No active game connections. Launch or optimize an app to monitor live traffic here." FontFamily="/Resources/Fonts/#Rajdhani" FontSize="14" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
