<Window
    x:Class="RouteXia.App.Views.ModernPromptWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="RouteXia Notification"
    Width="500"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="NoResize"
    Background="Transparent"
    AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="ModalSecondaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#101826" />
            <Setter Property="BorderBrush" Value="#1C2B40" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#8A99AD" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="btnBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#182438" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#2E4466" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#0A101A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModalPrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#00C2FF" />
            <Setter Property="BorderBrush" Value="#00C2FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#05080E" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="btnBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border
        Margin="16"
        Background="#0D1420"
        BorderBrush="#1A2B42"
        BorderThickness="1.5"
        CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#000000" Opacity="0.85" />
        </Border.Effect>
        <Grid>
            <!-- Top Cyber Glow Header Line -->
            <Border
                x:Name="TopGlowBar"
                Height="3"
                VerticalAlignment="Top"
                CornerRadius="14,14,0,0"
                Background="{StaticResource AccentBrush}" />

            <Grid Margin="24,20,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header Row: Icon + Title + Close Button -->
                <Grid Grid.Row="0" Margin="0,0,0,16" MouseDown="OnHeaderMouseDown" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Glowing Icon Box -->
                    <Border
                        x:Name="IconBox"
                        Grid.Column="0"
                        Width="44"
                        Height="44"
                        Background="#121D2F"
                        BorderBrush="#00C2FF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Margin="0,0,14,0">
                        <ui:SymbolIcon
                            x:Name="DialogIcon"
                            Symbol="Shield24"
                            FontSize="22"
                            Foreground="#00C2FF"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="TxtTitle"
                            Text="SUBSCRIPTION REQUIRED"
                            FontFamily="/Resources/Fonts/#Rajdhani"
                            FontWeight="Bold"
                            FontSize="19"
                            Foreground="#E8EDF5" />
                        <TextBlock
                            x:Name="TxtCategory"
                            Text="RouteXia Notification"
                            Style="{StaticResource CaptionStyle}"
                            Foreground="#6B7684"
                            FontSize="11"
                            Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Close [✕] -->
                    <Button
                        Grid.Column="2"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Foreground="#6B7684"
                        Cursor="Hand"
                        Click="BtnClose_Click"
                        VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                    </Button>
                </Grid>

                <!-- Content Card -->
                <Border
                    Grid.Row="1"
                    Background="#090E17"
                    BorderBrush="#151F2E"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18,16"
                    Margin="0,0,0,20">
                    <TextBlock
                        x:Name="TxtMessage"
                        Text="An active subscription or trial is required to connect to RouteXia gaming relays."
                        Style="{StaticResource CaptionStyle}"
                        Foreground="#C4D1E0"
                        FontSize="13"
                        LineHeight="20"
                        TextWrapping="Wrap" />
                </Border>

                <!-- Action Buttons -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="BtnSecondary"
                        Grid.Column="0"
                        Height="42"
                        Style="{StaticResource ModalSecondaryBtnStyle}"
                        Click="BtnSecondary_Click">
                        <TextBlock
                            x:Name="TxtSecondaryBtn"
                            Text="CANCEL"
                            FontFamily="/Resources/Fonts/#Rajdhani"
                            FontWeight="Bold"
                            FontSize="15" />
                    </Button>

                    <Button
                        x:Name="BtnPrimary"
                        Grid.Column="2"
                        Height="42"
                        Style="{StaticResource ModalPrimaryBtnStyle}"
                        Click="BtnPrimary_Click">
                        <TextBlock
                            x:Name="TxtPrimaryBtn"
                            Text="OPEN ACCOUNT"
                            FontFamily="/Resources/Fonts/#Rajdhani"
                            FontWeight="Bold"
                            FontSize="15" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
