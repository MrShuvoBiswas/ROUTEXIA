<Page
    x:Class="RouteXia.App.Views.AuthView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Profile"
    Background="#05070B"
    Foreground="White"
    FontFamily="/Resources/Fonts/#Rajdhani">

    <Page.Resources>
        <!-- Fade in animation on load -->
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,20,0,-20" To="0,0,0,0" Duration="0:0:0.6">
                <ThicknessAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </ThicknessAnimation.EasingFunction>
            </ThicknessAnimation>
        </Storyboard>

        <!-- Premium Button Style (Clean, Modern, Glow-Free) -->
        <Style x:Key="PremiumButtonStyle" TargetType="ui:Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="FontFamily" Value="/Resources/Fonts/#Rajdhani"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                BorderBrush="#0088EE"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0088EE"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00A2FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0066AA"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0066AA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button Style -->
        <Style x:Key="GhostButtonStyle" TargetType="ui:Button">
            <Setter Property="Background" Value="#0D1520"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#1C2B3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:Button">
                        <Grid>
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                            <Border x:Name="hoverOverlay" Background="White" Opacity="0" CornerRadius="8" IsHitTestVisible="False" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverOverlay" Storyboard.TargetProperty="Opacity" To="0.05" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Style -->
        <Style x:Key="PremiumCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#080C13"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="32,28"/>
            <Setter Property="BorderBrush" Value="#1C2B3C" />
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B8095"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="/Resources/Fonts/#Rajdhani"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Page.Resources>

    <Grid Margin="48,40,48,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Main Content -->
        </Grid.RowDefinitions>

        <!-- ── HEADER ────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="My Account" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="36" FontWeight="Bold" Foreground="#FFFFFF" />
                <TextBlock Text="Manage your data, subscription, and account settings." FontSize="14" Foreground="#8FA5BD" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button
                    Click="BtnMoreDetails_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="10,6"
                    Cursor="Hand"
                    Margin="0,0,24,0"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="More Details" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="14" FontWeight="Bold" Foreground="#8FA5BD" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <ui:SymbolIcon Symbol="Open24" FontSize="14" Foreground="#8FA5BD" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>

                <ui:Button
                    Click="BtnLogout_Click"
                    Style="{StaticResource GhostButtonStyle}"
                    Padding="18,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Log Out" FontSize="14" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <ui:SymbolIcon Symbol="SignOut24" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!-- ── CARDS ─────────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5.5*" />
                <ColumnDefinition Width="0.5*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!-- CARD 1: My Data -->
            <Border Grid.Column="0" Style="{StaticResource PremiumCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,24">
                        <ui:SymbolIcon Symbol="PersonBoard24" FontSize="20" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="My Data" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>

                    <Separator Grid.Row="1" Background="#1C2B3C" Margin="0,0,0,24" Height="1" BorderThickness="0" />

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Email -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="EMAIL ADDRESS" Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{Binding UserEmail}" Style="{StaticResource ValueStyle}" />
                        </StackPanel>

                        <!-- Country -->
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Text="COUNTRY" Style="{StaticResource LabelStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CountryDisplay}" Style="{StaticResource ValueStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Internet Provider -->
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="INTERNET PROVIDER" Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{Binding InternetProvider}" Style="{StaticResource ValueStyle}" />
                        </StackPanel>

                        <!-- Affiliate Link -->
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock Text="MY AFFILIATE LINK" Style="{StaticResource LabelStyle}" Margin="0,0,0,10" />
                            <ui:Button
                                Click="BtnActivateAffiliate_Click"
                                Style="{StaticResource PremiumButtonStyle}"
                                HorizontalAlignment="Left"
                                Padding="20,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Activate" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <ui:SymbolIcon Symbol="Link24" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- CARD 2: Account Details -->
            <Border Grid.Column="2" Style="{StaticResource PremiumCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,24">
                        <ui:SymbolIcon Symbol="ShieldTask24" FontSize="20" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Account Details" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>

                    <Separator Grid.Row="1" Background="#1C2B3C" Margin="0,0,0,24" Height="1" BorderThickness="0" />

                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Avatar / Status Icon -->
                        <Grid HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Border Width="64" Height="64" CornerRadius="32" Background="#0A1018" BorderBrush="#1C2B3C" BorderThickness="1.5">
                                <ui:SymbolIcon Symbol="Premium24" FontSize="28" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding SubscriptionTitle}" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                        
                        <TextBlock Text="{Binding SubscriptionSubtitle}" FontSize="13" Foreground="#8FA5BD" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,32" MaxWidth="220" TextWrapping="Wrap" />

                        <ui:Button Click="BtnSubscribe_Click" Style="{StaticResource PremiumButtonStyle}" HorizontalAlignment="Center" Padding="40,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Subscribe Now" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ui:SymbolIcon Symbol="ArrowRight24" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
