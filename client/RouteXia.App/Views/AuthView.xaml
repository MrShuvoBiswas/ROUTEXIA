<Page
    x:Class="RouteXia.App.Views.AuthView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Account &amp; Subscription"
    Background="Transparent">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Profile Card Gradient -->
        <LinearGradientBrush x:Key="ProfileCardBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#121D2B" Offset="0" />
            <GradientStop Color="#090E17" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ProfileCardBorder" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00C2FF" Offset="0" />
            <GradientStop Color="#162738" Offset="1" />
        </LinearGradientBrush>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="36,24,36,36" MaxWidth="620" HorizontalAlignment="Center">
            
            <!-- ── Authenticated User Profile View ────────────────────────────── -->
            <StackPanel x:Name="PanelProfile">
                
                <!-- Main Gamer Profile Card -->
                <Border
                    Background="{StaticResource ProfileCardBg}"
                    BorderBrush="{StaticResource ProfileCardBorder}"
                    BorderThickness="1.5"
                    CornerRadius="20"
                    Padding="28"
                    Margin="0,0,0,24">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="30" Opacity="0.5" ShadowDepth="6" />
                    </Border.Effect>

                    <StackPanel>
                        
                        <!-- User Header -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Avatar Badge -->
                            <Border
                                Grid.Column="0"
                                Width="52" Height="52"
                                CornerRadius="26"
                                Background="#102A3D"
                                BorderBrush="#00E5FF"
                                BorderThickness="1.5"
                                Margin="0,0,16,0">
                                <ui:SymbolIcon Symbol="Person24" FontSize="24" Foreground="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- User Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{Binding UserEmail}"
                                    FontFamily="/Resources/Fonts/#Rajdhani"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="#FFFFFF" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Background="#133624" BorderBrush="#00E676" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="VERIFIED GAMER" FontSize="9" FontWeight="Bold" Foreground="#00E676" />
                                    </Border>
                                    <TextBlock Text="RouteXia Cloud Network" FontSize="11" Foreground="#748CA3" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Plan Badge -->
                            <Border
                                Grid.Column="2"
                                Background="#102A3D"
                                BorderBrush="#00C2FF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,6"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="{Binding PlanBadgeText}"
                                    FontFamily="/Resources/Fonts/#Rajdhani"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="#00E5FF" />
                            </Border>
                        </Grid>

                        <Rectangle Height="1" Fill="#192A3C" Margin="0,0,0,20" />

                        <!-- Subscription Status Grid -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SUBSCRIPTION STATUS" FontSize="10" FontWeight="Bold" Foreground="#6C849B" />
                                <TextBlock Text="{Binding SubscriptionStatusText}" FontSize="15" FontWeight="SemiBold" Foreground="#E6EFF8" Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#0C1D2B" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DaysLeftText}" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="14" FontWeight="Bold" Foreground="#00E5FF" />
                            </Border>
                        </Grid>

                        <!-- Hardware Device Binding -->
                        <Border Background="#070C12" BorderBrush="#14202E" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="ShieldCheckmark20" FontSize="16" Foreground="#00E676" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="HARDWARE SECURITY LOCK (HWID)" FontSize="10" FontWeight="Bold" Foreground="#5E758C" />
                                    <TextBlock Text="{Binding HwidPreview, StringFormat='Device: {0}'}" FontSize="11" FontFamily="/Resources/Fonts/#JetBrains Mono" Foreground="#9BB2C8" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="#11291F" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="BOUND" FontSize="9" FontWeight="Bold" Foreground="#00E676" />
                                </Border>
                            </Grid>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- Actions / Sign Out Button -->
                <ui:Button
                    Content="Sign Out of RouteXia"
                    Click="BtnLogout_Click"
                    HorizontalAlignment="Right"
                    Background="#141E2B"
                    BorderBrush="#233448"
                    BorderThickness="1"
                    CornerRadius="10"
                    Foreground="#A0B6CB"
                    FontFamily="/Resources/Fonts/#Rajdhani"
                    FontWeight="Bold"
                    FontSize="13"
                    Padding="20,10"
                    Cursor="Hand" />
            </StackPanel>

            <!-- ── Fallback Auth Panel (if opened directly) ────────────────────────── -->
            <StackPanel x:Name="PanelAuth" Visibility="Collapsed">
                <TextBlock Text="Please sign in from the login window." Foreground="#A0B6CB" HorizontalAlignment="Center" Margin="0,40" />
            </StackPanel>

        </Grid>
    </ScrollViewer>
</Page>
