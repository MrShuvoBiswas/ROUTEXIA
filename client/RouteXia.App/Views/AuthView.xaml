<Page
    x:Class="RouteXia.App.Views.AuthView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Account &amp; Subscription"
    Background="Transparent">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,32" MaxWidth="600" HorizontalAlignment="Center">
            
            <!-- ── 1. Authenticated User Profile View ────────────────────────────── -->
            <StackPanel x:Name="PanelProfile" Visibility="Collapsed">
                
                <!-- Profile Header Card -->
                <Border
                    Background="{StaticResource BgPanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="24"
                    Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="48" Height="48" CornerRadius="24" Background="#142B3B" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" Margin="0,0,16,0">
                                <ui:SymbolIcon Symbol="Person24" FontSize="22" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserEmail}" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="RouteXia Member" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,16" />

                        <!-- Subscription Status -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SUBSCRIPTION PLAN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding SubscriptionStatusText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#133827" BorderBrush="{StaticResource StatusGoodBrush}" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DaysLeftText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource StatusGoodBrush}" />
                            </Border>
                        </Grid>

                        <!-- HWID Fingerprint -->
                        <Border Background="#09141D" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="ShieldCheckmark20" FontSize="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding HwidPreview, StringFormat='HWID Protected: {0}'}" FontSize="11" FontFamily="/Resources/Fonts/#JetBrains Mono" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Logout Button -->
                <Button
                    Content="Sign Out"
                    Click="BtnLogout_Click"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    BorderBrush="{StaticResource BorderBrush}"
                    Foreground="{StaticResource TextMutedBrush}"
                    Padding="16,8" />
            </StackPanel>

            <!-- ── 2. Login / Register Form View ──────────────────────────────────── -->
            <Border
                x:Name="PanelAuth"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="32">
                <StackPanel>
                    
                    <!-- Header -->
                    <TextBlock
                        Text="{Binding ModeTitle}"
                        FontFamily="/Resources/Fonts/#Rajdhani"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Margin="0,0,0,6" />
                    
                    <TextBlock
                        Text="Experience ultra-low latency &amp; packet loss protection on PUBG PC."
                        FontSize="12"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="0,0,0,24" />

                    <!-- Email Field -->
                    <TextBlock Text="EMAIL ADDRESS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                    <ui:TextBox
                        x:Name="TxtEmail"
                        Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Enter your email"
                        Margin="0,0,0,16" />

                    <!-- Password Field -->
                    <TextBlock Text="PASSWORD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                    <ui:PasswordBox
                        x:Name="TxtPassword"
                        PasswordChanged="TxtPassword_PasswordChanged"
                        PlaceholderText="Enter your password (min 6 characters)"
                        Margin="0,0,0,20" />

                    <!-- Status / Error Banner -->
                    <Border
                        x:Name="StatusBanner"
                        Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}"
                        Background="#142B3B"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        Margin="0,0,0,16">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    </Border>

                    <!-- Submit Button -->
                    <Button
                        x:Name="BtnSubmit"
                        Content="{Binding ModeTitle}"
                        Click="BtnSubmit_Click"
                        Height="44"
                        Background="{StaticResource AccentBrush}"
                        Foreground="#0A0E17"
                        FontWeight="Bold"
                        FontSize="14"
                        Margin="0,0,0,16" />

                    <!-- Switch Mode Button -->
                    <Button
                        Content="{Binding SwitchButtonText}"
                        Click="BtnSwitchMode_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource AccentBrush}"
                        HorizontalAlignment="Center"
                        FontSize="12" />

                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</Page>
