<ui:FluentWindow
    x:Class="RouteXia.App.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="RouteXia"
    Width="980"
    Height="580"
    MinWidth="980"
    MinHeight="580"
    MaxWidth="980"
    MaxHeight="580"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    Background="#080C12">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Red Accent for Errors / ExitLag aesthetic -->
        <SolidColorBrush x:Key="ErrorRedBrush" Color="#FF3B30" />
        <SolidColorBrush x:Key="CardDarkBg" Color="#0D121B" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Custom Titlebar -->
            <RowDefinition Height="*" />
            <!-- Split Content Area -->
        </Grid.RowDefinitions>

        <!-- Ambient Background Orbital Rings (ExitLag Vector Graphics) -->
        <Canvas Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse
                Width="900" Height="900"
                Stroke="#0E2235" StrokeThickness="1.5"
                Canvas.Left="-150" Canvas.Top="-150" Opacity="0.6" />
            <Ellipse
                Width="700" Height="700"
                Stroke="#00E5FF" StrokeThickness="1" StrokeDashArray="4 8"
                Canvas.Left="-50" Canvas.Top="-50" Opacity="0.18" />
            <Ellipse
                Width="1100" Height="1100"
                Stroke="#143048" StrokeThickness="1"
                Canvas.Left="-250" Canvas.Top="-250" Opacity="0.4" />
            <Ellipse
                Width="400" Height="400"
                Canvas.Left="-100" Canvas.Top="50" Opacity="0.15">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#00C2FF" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- Custom Titlebar -->
        <ui:TitleBar
            Grid.Row="0"
            Title=""
            ShowMaximize="False"
            ShowMinimize="True"
            Background="Transparent" />

        <!-- ── Main 2-Column Split Content (ExitLag Layout) ───────────────── -->
        <Grid Grid.Row="1" Margin="48,0,48,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <!-- Left Showcase -->
                <ColumnDefinition Width="380" />
                <!-- Right Login Box -->
            </Grid.ColumnDefinitions>

            <!-- ══════════════════════════════════════════════════════════════ -->
            <!-- ── LEFT COLUMN: Gamer Showcase & Latency Benefits ───────────── -->
            <!-- ══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,40,0">
                <StackPanel>

                    <!-- Language Selector Pill -->
                    <Border
                        Background="#0F1722"
                        BorderBrush="#1B283A"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,5"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,28">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Globe20" FontSize="14" Foreground="#8CA3B8" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="English (US)" FontSize="11" FontWeight="SemiBold" Foreground="#CCD8E5" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ui:SymbolIcon Symbol="ChevronDown16" FontSize="10" Foreground="#6C8399" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Headline (ExitLag Style) -->
                    <TextBlock
                        Text="AN AI-POWERED"
                        FontFamily="/Resources/Fonts/#Rajdhani"
                        FontSize="36"
                        FontWeight="Bold"
                        Foreground="#FFFFFF" />
                    <TextBlock
                        Text="GAME OPTIMIZATION"
                        FontFamily="/Resources/Fonts/#Rajdhani"
                        FontSize="36"
                        FontWeight="Bold"
                        Foreground="#FFFFFF" />
                    <TextBlock
                        Text="PLATFORM"
                        FontFamily="/Resources/Fonts/#Rajdhani"
                        FontSize="36"
                        FontWeight="Bold"
                        Foreground="#00E5FF"
                        Margin="0,0,0,32" />

                    <!-- Live Gamer Metrics -->
                    <Grid Margin="0,0,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Stat 1 -->
                        <StackPanel Grid.Column="0" Margin="0,0,32,0">
                            <TextBlock Text="Multipath" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock Text="Technology®" FontSize="10" Foreground="#7E95AC" />
                        </StackPanel>

                        <!-- Stat 2 -->
                        <StackPanel Grid.Column="1" Margin="0,0,32,0">
                            <TextBlock Text="0% PACKET LOSS" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="16" FontWeight="Bold" Foreground="#00E676" />
                            <TextBlock Text="TARGET STABILITY" FontSize="10" Foreground="#7E95AC" />
                        </StackPanel>

                        <!-- Stat 3 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="LOWEST PING" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="16" FontWeight="Bold" Foreground="#00E5FF" />
                            <TextBlock Text="REAL-TIME ROUTING" FontSize="10" Foreground="#7E95AC" />
                        </StackPanel>
                    </Grid>

                    <!-- Bottom Feature Badges -->
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#121824" BorderBrush="#1C283A" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Flash20" FontSize="12" Foreground="#00E5FF" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="A.I. Route Optimizer" FontSize="11" FontWeight="SemiBold" Foreground="#95ACC4" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Background="#121824" BorderBrush="#1C283A" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ShieldCheckmark20" FontSize="12" Foreground="#00E676" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="Dynamic Stabilizer" FontSize="11" FontWeight="SemiBold" Foreground="#95ACC4" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Background="#121824" BorderBrush="#1C283A" BorderThickness="1" CornerRadius="8" Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Globe24" FontSize="12" Foreground="#00E5FF" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="Global Routing" FontSize="11" FontWeight="SemiBold" Foreground="#95ACC4" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════════ -->
            <!-- ── RIGHT COLUMN: Clean ExitLag Login Card ───────────────────── -->
            <!-- ══════════════════════════════════════════════════════════════ -->
            <Border
                Grid.Column="1"
                Background="{StaticResource CardDarkBg}"
                BorderBrush="#1A2536"
                BorderThickness="1"
                CornerRadius="18"
                Padding="32,28"
                VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="40" Opacity="0.6" ShadowDepth="10" />
                </Border.Effect>

                <StackPanel>

                    <!-- Logo Header -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock
                                Text="ROUTE"
                                FontFamily="/Resources/Fonts/#Rajdhani"
                                FontSize="28"
                                FontWeight="Bold"
                                Foreground="#00E5FF" />
                            <TextBlock
                                Text="XIA"
                                FontFamily="/Resources/Fonts/#Rajdhani"
                                FontSize="28"
                                FontWeight="Bold"
                                Foreground="#FFFFFF" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Email Input (Native Single-Layer Clean TextBox) -->
                    <ui:TextBox
                        x:Name="TxtEmail"
                        Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Enter email"
                        Height="42"
                        FontSize="13"
                        Margin="0,0,0,4" />

                    <!-- Email Error Message -->
                    <TextBlock
                        x:Name="LblEmailError"
                        Text="Email cannot be empty"
                        FontSize="10"
                        Foreground="{StaticResource ErrorRedBrush}"
                        Visibility="Collapsed"
                        Margin="2,0,0,8" />

                    <!-- Password Input (Native Single-Layer Clean PasswordBox) -->
                    <ui:PasswordBox
                        x:Name="TxtPassword"
                        PasswordChanged="TxtPassword_PasswordChanged"
                        PlaceholderText="Enter password"
                        Height="42"
                        FontSize="13"
                        Margin="0,8,0,4" />

                    <!-- Password Error Message -->
                    <TextBlock
                        x:Name="LblPasswordError"
                        Text="Password cannot be empty"
                        FontSize="10"
                        Foreground="{StaticResource ErrorRedBrush}"
                        Visibility="Collapsed"
                        Margin="2,0,0,8" />

                    <!-- Status Message / Server Error Banner -->
                    <Border
                        x:Name="StatusBanner"
                        Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}"
                        Background="#1A1824"
                        BorderBrush="{StaticResource ErrorRedBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,4"
                        Margin="0,4,0,6">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#FFA5A0" TextWrapping="Wrap" HorizontalAlignment="Center" />
                    </Border>

                    <!-- Remember Me & Forgot Password Row -->
                    <Grid Margin="2,8,2,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Keep me logged in checkbox -->
                        <CheckBox
                            Grid.Column="0"
                            Content="Keep me logged in"
                            IsChecked="True"
                            FontSize="11"
                            Foreground="#8FA5BB"
                            VerticalAlignment="Center" />

                        <!-- Forgot password link -->
                        <TextBlock
                            Grid.Column="1"
                            Text="Forgot password?"
                            FontSize="11"
                            Foreground="#8FA5BB"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            MouseLeftButtonUp="LnkForgotPassword_Click" />
                    </Grid>

                    <!-- Full-Width In-App Login Button -->
                    <ui:Button
                        x:Name="BtnLogin"
                        Content="Login"
                        Click="BtnLogin_Click"
                        Height="42"
                        HorizontalAlignment="Stretch"
                        Background="#1A2433"
                        BorderBrush="#25354C"
                        BorderThickness="1"
                        CornerRadius="8"
                        Foreground="#FFFFFF"
                        FontFamily="/Resources/Fonts/#Rajdhani"
                        FontWeight="Bold"
                        FontSize="15"
                        Cursor="Hand"
                        Margin="0,0,0,16" />

                    <!-- "Or continue with" -->
                    <TextBlock
                        Text="Or continue with"
                        FontSize="11"
                        Foreground="#5B6F82"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12" />

                    <!-- Google 1-Click Button (Redirects to Web Auth) -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                        <ui:Button
                            x:Name="BtnGoogleAuth"
                            Click="BtnGoogleAuth_Click"
                            Width="44" Height="44"
                            CornerRadius="22"
                            Background="#141B26"
                            BorderBrush="#253346"
                            BorderThickness="1"
                            Cursor="Hand"
                            Padding="0">
                            <TextBlock Text="G" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="18" FontWeight="Bold" Foreground="#EA4335" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </ui:Button>
                        <TextBlock Text="Google" FontSize="10" Foreground="#6C8399" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Register Link (Opens Web Portal for 4-day trial) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Don't have an account? " FontSize="11" Foreground="#6E849A" />
                        <TextBlock
                            Text="Register"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="#FFFFFF"
                            Cursor="Hand"
                            MouseLeftButtonUp="LnkRegister_Click" />
                    </StackPanel>

                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</ui:FluentWindow>
