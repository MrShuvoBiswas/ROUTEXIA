<ui:FluentWindow
    x:Class="RouteXia.App.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="RouteXia — Enterprise Gaming Network"
    Width="460"
    Height="680"
    MinWidth="460"
    MinHeight="680"
    MaxWidth="460"
    MaxHeight="680"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Ambient Dark Gradient Background -->
        <RadialGradientBrush x:Key="WindowBgBrush" Center="0.5,0.1" GradientOrigin="0.5,0.1" RadiusX="0.9" RadiusY="0.9">
            <GradientStop Color="#102234" Offset="0" />
            <GradientStop Color="#090E16" Offset="0.55" />
            <GradientStop Color="#05080D" Offset="1" />
        </RadialGradientBrush>

        <!-- Glass Card Background -->
        <LinearGradientBrush x:Key="CardBgBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#121A26" Offset="0" />
            <GradientStop Color="#0A0F17" Offset="1" />
        </LinearGradientBrush>

        <!-- Glass Card Border -->
        <LinearGradientBrush x:Key="CardBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2A3C54" Offset="0" />
            <GradientStop Color="#141E2B" Offset="1" />
        </LinearGradientBrush>

        <!-- Primary Accent Gradient -->
        <LinearGradientBrush x:Key="PrimaryBtnBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00E5FF" Offset="0" />
            <GradientStop Color="#0088FF" Offset="1" />
        </LinearGradientBrush>

        <!-- Google Button Background -->
        <LinearGradientBrush x:Key="GoogleBtnBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#172232" Offset="0" />
            <GradientStop Color="#0E1622" Offset="1" />
        </LinearGradientBrush>

        <!-- Input Field Background -->
        <SolidColorBrush x:Key="InputBgBrush" Color="#070B10" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#182333" />
    </ui:FluentWindow.Resources>

    <Grid Background="{StaticResource WindowBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Custom Titlebar -->
            <RowDefinition Height="*" />
            <!-- Main Content Area -->
        </Grid.RowDefinitions>

        <!-- Ambient Decorative Top Glow -->
        <Ellipse
            Grid.RowSpan="2"
            Width="300" Height="140"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="0,-40,0,0"
            Opacity="0.4"
            IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#00C2FF" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Custom Clean Titlebar -->
        <ui:TitleBar
            Grid.Row="0"
            Title=""
            ShowMaximize="False"
            ShowMinimize="True"
            Background="Transparent" />

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="32,0,32,24">
            <StackPanel VerticalAlignment="Center">

                <!-- ── 1. Enterprise Logo & Branding ────────────────────────── -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                    
                    <!-- Futuristic Shield Icon Badge -->
                    <Border
                        Width="56" Height="56"
                        CornerRadius="16"
                        BorderThickness="1.5"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#142B40" Offset="0" />
                                <GradientStop Color="#091420" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00E5FF" Offset="0" />
                                <GradientStop Color="#0055FF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect Color="#00E5FF" BlurRadius="20" Opacity="0.35" ShadowDepth="0" />
                        </Border.Effect>
                        <ui:SymbolIcon Symbol="Flash24" FontSize="26" Foreground="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Dual-Tone Title -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock
                            Text="ROUTE"
                            FontFamily="/Resources/Fonts/#Rajdhani"
                            FontSize="32"
                            FontWeight="Bold"
                            Foreground="#00E5FF" />
                        <TextBlock
                            Text="XIA"
                            FontFamily="/Resources/Fonts/#Rajdhani"
                            FontSize="32"
                            FontWeight="Bold"
                            Foreground="#FFFFFF" />
                    </StackPanel>

                    <!-- Subtitle Badge -->
                    <Border
                        Background="#0D1E2D"
                        BorderBrush="#19354E"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,3"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center">
                        <TextBlock
                            Text="MULTIPATH UDP GAMING ACCELERATOR"
                            FontFamily="/Resources/Fonts/#Rajdhani"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="#7097B8" />
                    </Border>
                </StackPanel>

                <!-- ── 2. Glassmorphic Login Card ───────────────────────────── -->
                <Border
                    Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="24,22"
                    Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="40" Opacity="0.6" ShadowDepth="10" />
                    </Border.Effect>

                    <StackPanel>

                        <!-- Primary 1-Click Browser/Google Action -->
                        <ui:Button
                            x:Name="BtnBrowserLogin"
                            Click="BtnBrowserLogin_Click"
                            Height="48"
                            Background="{StaticResource PrimaryBtnBrush}"
                            BorderThickness="0"
                            CornerRadius="12"
                            Foreground="#050B12"
                            FontWeight="Bold"
                            FontSize="14"
                            Cursor="Hand"
                            Margin="0,0,0,8">
                            <ui:Button.Effect>
                                <DropShadowEffect Color="#00C2FF" BlurRadius="18" Opacity="0.45" ShadowDepth="2" />
                            </ui:Button.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Globe24" FontSize="19" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Sign In with Browser / Google" FontFamily="/Resources/Fonts/#Rajdhani" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>

                        <TextBlock
                            Text="Instant 1-click login &amp; auto-claim 4-day trial"
                            FontSize="11"
                            Foreground="#62788E"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,14" />

                        <!-- Elegant Divider -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Height="1" Fill="#162232" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="OR USE EMAIL" FontSize="10" FontWeight="Bold" Foreground="#4A5F73" Margin="10,0" VerticalAlignment="Center" />
                            <Rectangle Grid.Column="2" Height="1" Fill="#162232" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Email Input -->
                        <TextBlock Text="EMAIL ADDRESS" FontSize="10" FontWeight="Bold" Foreground="#7E95AC" Margin="2,0,0,5" />
                        <Border Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,10">
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Mail20" FontSize="14" Foreground="#45607B" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox
                                    Grid.Column="1"
                                    x:Name="TxtEmail"
                                    Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#E6EDF5"
                                    FontSize="13"
                                    Padding="0,10"
                                    CaretBrush="#00E5FF" />
                            </Grid>
                        </Border>

                        <!-- Password Input -->
                        <TextBlock Text="PASSWORD" FontSize="10" FontWeight="Bold" Foreground="#7E95AC" Margin="2,0,0,5" />
                        <Border Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,12">
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="LockClosed20" FontSize="14" Foreground="#45607B" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <PasswordBox
                                    Grid.Column="1"
                                    x:Name="TxtPassword"
                                    PasswordChanged="TxtPassword_PasswordChanged"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#E6EDF5"
                                    FontSize="13"
                                    Padding="0,10"
                                    CaretBrush="#00E5FF" />
                            </Grid>
                        </Border>

                        <!-- Status / Notice Banner -->
                        <Border
                            x:Name="StatusBanner"
                            Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}"
                            Background="#142838"
                            BorderBrush="#00C2FF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6"
                            Margin="0,0,0,10">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#E0F2FE" TextWrapping="Wrap" HorizontalAlignment="Center" />
                        </Border>

                        <!-- Email Submit Button -->
                        <ui:Button
                            x:Name="BtnDirectSubmit"
                            Content="{Binding ModeTitle}"
                            Click="BtnDirectSubmit_Click"
                            Height="38"
                            Background="{StaticResource GoogleBtnBg}"
                            BorderBrush="#1E2F44"
                            BorderThickness="1"
                            CornerRadius="10"
                            Foreground="#D0DEEB"
                            FontFamily="/Resources/Fonts/#Rajdhani"
                            FontWeight="Bold"
                            FontSize="14"
                            Cursor="Hand"
                            Margin="0,0,0,10" />

                        <!-- Mode Switcher (Sign In vs Free Trial) -->
                        <ui:Button
                            Content="{Binding SwitchButtonText}"
                            Click="BtnSwitchMode_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#00E5FF"
                            FontFamily="/Resources/Fonts/#Rajdhani"
                            FontWeight="Bold"
                            FontSize="13"
                            HorizontalAlignment="Center"
                            Cursor="Hand" />

                    </StackPanel>
                </Border>

                <!-- ── 3. Enterprise Trust & Security Badges ─────────────────── -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Opacity="0.75">
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                        <ui:SymbolIcon Symbol="ShieldCheckmark20" FontSize="13" Foreground="#00E676" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="BattlEye Safe" FontSize="10" FontWeight="SemiBold" Foreground="#829BB2" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                        <ui:SymbolIcon Symbol="Key20" FontSize="13" Foreground="#00C2FF" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="HWID Protected" FontSize="10" FontWeight="SemiBold" Foreground="#829BB2" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="TopSpeed24" FontSize="13" Foreground="#FFB020" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="Ultra-Low Latency" FontSize="10" FontWeight="SemiBold" Foreground="#829BB2" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
