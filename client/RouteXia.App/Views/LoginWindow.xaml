<ui:FluentWindow
    x:Class="RouteXia.App.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="RouteXia — Sign In"
    Width="440"
    Height="600"
    MinWidth="440"
    MinHeight="600"
    MaxWidth="440"
    MaxHeight="600"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    Background="{StaticResource BgBaseBrush}">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Custom Titlebar -->
            <RowDefinition Height="*" />
            <!-- Main Content -->
        </Grid.RowDefinitions>

        <!-- Custom Titlebar -->
        <ui:TitleBar
            Grid.Row="0"
            Title=""
            ShowMaximize="False"
            ShowMinimize="True"
            Background="Transparent" />

        <!-- Main Login Card (ExitLag Style) -->
        <Grid Grid.Row="1" Margin="32,8,32,28">
            <StackPanel VerticalAlignment="Center">

                <!-- Logo & Brand Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock
                            Text="ROUTE"
                            FontFamily="/Resources/Fonts/#Rajdhani"
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="{StaticResource AccentBrush}" />
                        <TextBlock
                            Text="XIA"
                            FontFamily="/Resources/Fonts/#Rajdhani"
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock
                        Text="Multipath Game Network Accelerator"
                        FontSize="11"
                        Foreground="{StaticResource TextMutedBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0" />
                </StackPanel>

                <!-- ── 1. Primary Action: Browser / Google Sign-In ──────────────── -->
                <Button
                    x:Name="BtnBrowserLogin"
                    Click="BtnBrowserLogin_Click"
                    Height="48"
                    Background="{StaticResource AccentBrush}"
                    Foreground="#0A0E17"
                    FontWeight="Bold"
                    FontSize="14"
                    Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Globe24" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Sign In with Browser / Google" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock
                    Text="1-click Google sign-in or claim 4 days free trial"
                    FontSize="11"
                    Foreground="{StaticResource TextMutedBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16" />

                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,16" />

                <!-- ── 2. Direct Email / Password Form ───────────────────────────── -->
                <TextBlock Text="OR SIGN IN WITH EMAIL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />

                <TextBlock Text="EMAIL ADDRESS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                <ui:TextBox
                    x:Name="TxtEmail"
                    Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="gamer@example.com"
                    Margin="0,0,0,12" />

                <TextBlock Text="PASSWORD" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                <ui:PasswordBox
                    x:Name="TxtPassword"
                    PasswordChanged="TxtPassword_PasswordChanged"
                    PlaceholderText="••••••••"
                    Margin="0,0,0,14" />

                <!-- Status / Error Message Banner -->
                <Border
                    x:Name="StatusBanner"
                    Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}"
                    Background="#142B3B"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,6"
                    Margin="0,0,0,12">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                </Border>

                <!-- Direct Submit Button -->
                <Button
                    x:Name="BtnDirectSubmit"
                    Content="{Binding ModeTitle}"
                    Click="BtnDirectSubmit_Click"
                    Height="38"
                    Background="#141C28"
                    BorderBrush="{StaticResource BorderBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    FontWeight="SemiBold"
                    FontSize="13"
                    Margin="0,0,0,12" />

                <!-- Switch Mode (Sign In vs 4 Days Trial) -->
                <Button
                    Content="{Binding SwitchButtonText}"
                    Click="BtnSwitchMode_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{StaticResource AccentBrush}"
                    HorizontalAlignment="Center"
                    FontSize="11" />

            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
