<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RouteXia.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="{StaticResource BgBaseBrush}"
    Title="Settings">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,28" MaxWidth="560">

            <TextBlock
                Text="SETTINGS"
                FontFamily="/Resources/Fonts/#Rajdhani"
                FontSize="22"
                FontWeight="Bold"
                Foreground="{StaticResource TextPrimaryBrush}"
                Margin="0,0,0,28" />

            <!-- Game Optimization -->
            <TextBlock
                Text="GAME OPTIMIZATION"
                FontSize="11" FontWeight="SemiBold"
                Foreground="{StaticResource TextMutedBrush}"
                Margin="0,0,0,12" />

            <Border
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="12"
                Padding="20,16" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Auto-Connect on Game Launch" FontSize="13"
                                FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Automatically optimize routes when the selected game starts"
                                FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoConnectOnGameLaunch}"
                            VerticalAlignment="Center" />
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,4,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Route Optimization Mode" FontSize="13"
                                FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Game-specific Split-Tunneling (Game traffic only)"
                                FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#1A2230" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="⚡ Smart Split" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- System -->
            <TextBlock
                Text="SYSTEM"
                FontSize="11" FontWeight="SemiBold"
                Foreground="{StaticResource TextMutedBrush}"
                Margin="0,0,0,12" />

            <Border
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="12"
                Padding="20,16" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Minimize to System Tray" FontSize="13"
                                FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Keep running in background for game detection"
                                FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTray}"
                            VerticalAlignment="Center" />
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,4,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Start with Windows" FontSize="13"
                                FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Launch RouteXia silently when Windows starts"
                                FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding StartWithWindows}"
                            VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- About -->
            <TextBlock
                Text="ABOUT"
                FontSize="11" FontWeight="SemiBold"
                Foreground="{StaticResource TextMutedBrush}"
                Margin="0,0,0,12" />

            <Border
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="12"
                Padding="20,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="RouteXia" FontSize="14"
                                FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="AI-Powered Game Route Optimizer"
                                FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#1A2230" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="v0.1.0-beta" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,4,0,12" />

                    <TextBlock
                        Text="RouteXia uses Multipath Routing Technology to find the fastest path for your game traffic, reducing ping and eliminating packet loss."
                        FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
