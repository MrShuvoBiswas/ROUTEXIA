<Page
    x:Class="RouteXia.App.Views.ConnectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:RouteXia.App.ViewModels"
    xmlns:views="clr-namespace:RouteXia.App.Views"
    Background="{StaticResource BgBaseBrush}"
    Title="PUBG Boost">

    <Page.Resources>
        <Style x:Key="PageCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="/Resources/Fonts/#Rajdhani" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="MutedLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>

        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryAction" TargetType="Button">
            <Setter Property="Height" Value="58" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Background" Value="{StaticResource NavActiveBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryAction" TargetType="Button">
            <Setter Property="Height" Value="58" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RelayAction" TargetType="Button">
            <Setter Property="MinHeight" Value="68" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource NavActiveBgBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Height="110"
            VerticalAlignment="Top"
            Opacity="0.75"
            IsHitTestVisible="False"
            Background="{StaticResource AccentGlowBrush}" />

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock
                    Text="PUBG BOOST"
                    FontFamily="/Resources/Fonts/#Rajdhani"
                    FontSize="40"
                    FontWeight="Bold"
                    Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock
                    Text="SG relay, live ping, one-click optimize."
                    Margin="0,2,0,0"
                    FontSize="13"
                    Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════════
                 STATUS AREA — 5-State Connection Indicator  (T012-T017)
                 Each state layer is shown/hidden via DataTrigger on State.
                 Storyboards from StatusTransitions.xaml drive animations.
                 ALL colors reference ResourceDictionary tokens (SC-006).
            ══════════════════════════════════════════════════════════════ -->
            <Grid
                x:Name="StatusArea"
                Grid.Column="1"
                MinWidth="172"
                Height="42"
                VerticalAlignment="Center">

                <!-- ── State 1: DISCONNECTED ────────────────────────────── -->
                <Border
                    x:Name="StateDisconnected"
                    Padding="{StaticResource Sp2H}"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDisconnected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse
                            Width="8" Height="8"
                            Fill="{StaticResource TextMutedBrush}"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="DISCONNECTED"
                            Style="{StaticResource BadgeLabelStyle}"
                            Foreground="{StaticResource TextMutedBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- ── State 2: CONNECTING ──────────────────────────────── -->
                <Border
                    x:Name="StateConnecting"
                    Padding="{StaticResource Sp2H}"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Animated spinner arc -->
                        <Grid Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center">
                            <!-- Track ring -->
                            <Ellipse
                                Stroke="{StaticResource BorderBrush}"
                                StrokeThickness="2" />
                            <!-- Spinning arc -->
                            <Path
                                Stroke="{StaticResource AccentBrush}"
                                StrokeThickness="2"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                Data="M7,1 A6,6 0 0 1 13,7"
                                RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="ConnectingSpinnerRotate" CenterX="7" CenterY="7" />
                                </Path.RenderTransform>
                                <Path.Triggers>
                                    <EventTrigger RoutedEvent="Path.Loaded">
                                        <BeginStoryboard Storyboard="{StaticResource ConnectingSpinnerStoryboard}" />
                                    </EventTrigger>
                                </Path.Triggers>
                            </Path>
                        </Grid>
                        <TextBlock
                            Text="CONNECTING…"
                            Style="{StaticResource BadgeLabelStyle}"
                            Foreground="{StaticResource AccentBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- ── State 3: CONNECTED ───────────────────────────────── -->
                <Border
                    x:Name="StateConnected"
                    Padding="{StaticResource Sp2H}"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource StatusGoodBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ConnectionState.Connected}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Breathing glow dot -->
                        <Ellipse
                            x:Name="ConnectedGlowEllipse"
                            Width="8" Height="8"
                            Fill="{StaticResource StatusGoodBrush}"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Ellipse.Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource ConnectedGlowStoryboard}" />
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                Text="CONNECTED"
                                Style="{StaticResource BadgeLabelStyle}"
                                Foreground="{StaticResource StatusGoodBrush}" />
                            <TextBlock
                                Text="{Binding ActiveRouteLabel, FallbackValue='—'}"
                                Style="{StaticResource CaptionStyle}"
                                Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── State 4: OPTIMIZING ──────────────────────────────── -->
                <Border
                    x:Name="StateOptimizing"
                    Padding="{StaticResource Sp2H}"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOptimizing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 3-dot chase animation -->
                        <StackPanel
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                            <Ellipse x:Name="OptDot1" Width="5" Height="5" Fill="{StaticResource AccentBrush}" Margin="0,0,3,0" Opacity="1.0">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Ellipse.Loaded">
                                        <BeginStoryboard Storyboard="{StaticResource OptimizingPulseStoryboard}" />
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Ellipse x:Name="OptDot2" Width="5" Height="5" Fill="{StaticResource AccentBrush}" Margin="0,0,3,0" Opacity="0.25" />
                            <Ellipse x:Name="OptDot3" Width="5" Height="5" Fill="{StaticResource AccentBrush}" Opacity="0.25" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                Text="OPTIMIZING"
                                Style="{StaticResource BadgeLabelStyle}"
                                Foreground="{StaticResource AccentBrush}" />
                            <TextBlock
                                Text="{Binding ActiveRouteLabel, FallbackValue='Scoring routes…'}"
                                Style="{StaticResource CaptionStyle}"
                                Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── State 5: KILL-SWITCH ACTIVE ─────────────────────── -->
                <Border
                    x:Name="StateKillSwitch"
                    Padding="{StaticResource Sp2H}"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource StatusBadBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKillSwitchActive}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon
                            Symbol="ShieldDismiss24"
                            FontSize="14"
                            Foreground="{StaticResource StatusBadBrush}"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="KILL-SWITCH ACTIVE"
                            Style="{StaticResource BadgeLabelStyle}"
                            Foreground="{StaticResource StatusBadBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

            </Grid>
            <!-- ═════════════════════ END STATUS AREA ═════════════════════ -->

        </Grid>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
            <Border Style="{StaticResource PageCard}" Margin="0,0,12,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="1. SERVER" Style="{StaticResource MutedLabel}" />
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0" VerticalAlignment="Center">
                        <!-- Flag icon (Visible when connected or manual selection) -->
                        <Border
                            Width="20"
                            Height="14"
                            CornerRadius="2"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            ClipToBounds="True"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActiveFlagVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Image
                                Source="/Resources/Images/flag_sg.png"
                                Stretch="UniformToFill"
                                RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <!-- Auto Pulse Icon (Visible when disconnected in auto mode) -->
                        <ui:SymbolIcon
                            Symbol="Pulse24"
                            FontSize="16"
                            Foreground="{StaticResource AccentBrush}"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActiveFlagVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>

                        <TextBlock
                            Text="{Binding SelectedServerName}"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PageCard}" Margin="6,0,6,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="2. LIVE PING" Style="{StaticResource MutedLabel}" />
                    <TextBlock
                        Text="{Binding LivePingText}"
                        Margin="0,7,0,0"
                        FontFamily="/Resources/Fonts/#JetBrains Mono"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PageCard}" Margin="12,0,0,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="3. GAME" Style="{StaticResource MutedLabel}" />
                    <TextBlock
                        Text="PUBG READY"
                        Margin="0,7,0,0"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource StatusGoodBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.28*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.92*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PageCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Server" Style="{StaticResource PanelTitle}" />
                        <Border
                            Grid.Column="1"
                            Padding="9,4"
                            Background="{StaticResource BadgeBgBrush}"
                            CornerRadius="5">
                            <TextBlock
                                Text="{Binding ServerModeBadgeText}"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </Grid>

                    <UniformGrid Grid.Row="1" Columns="2" Margin="0,16,0,14">
                        <Button Click="BtnSelectAutoMode_Click" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAutoServerSelection}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource BgBaseBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Symbol="Pulse24"
                                    FontSize="15"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    Margin="0,0,7,0" />
                                <TextBlock
                                    Text="Auto best"
                                    FontWeight="Bold"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>

                        <Button Click="BtnSelectManualMode_Click" Margin="6,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsManualServerSelection}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource NavActiveBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon
                                    Symbol="Globe24"
                                    FontSize="15"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    Margin="0,0,7,0" />
                                <TextBlock
                                    Text="Pick relay"
                                    FontWeight="Bold"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <Border
                                    Background="{StaticResource AmberDimBrush}"
                                    BorderBrush="{StaticResource WarningBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4,1"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsManualRelayAllowed}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock
                                        Text="SOON"
                                        FontSize="8"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource WarningBrush}" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <Border
                        Grid.Row="2"
                        Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Flag icon (when Connected or Manual selection) -->
                            <Border
                                Grid.Column="0"
                                Width="32"
                                Height="22"
                                Background="{StaticResource BadgeBgBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                ClipToBounds="True"
                                SnapsToDevicePixels="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActiveFlagVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Image
                                    Source="/Resources/Images/flag_sg.png"
                                    Stretch="UniformToFill"
                                    RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>

                            <!-- Auto Mode Badge (when Disconnected in Auto Mode) -->
                            <Border
                                Grid.Column="0"
                                Width="32"
                                Height="22"
                                Background="{StaticResource NavActiveBgBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActiveFlagVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock
                                    Text="AUTO"
                                    FontSize="9"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource AccentBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{Binding CurrentRelayDisplayName, FallbackValue='Singapore'}"
                                    FontFamily="/Resources/Fonts/#Rajdhani"
                                    FontWeight="Bold"
                                    FontSize="16"
                                    Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock
                                    Text="{Binding CurrentRelaySubText, FallbackValue='Singapore BGP Multipath Route'}"
                                    Style="{StaticResource CaptionStyle}"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    FontSize="11" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock
                                    Text="{Binding CurrentRelayLatencyText, FallbackValue='-- ms'}"
                                    FontFamily="/Resources/Fonts/#Rajdhani"
                                    FontWeight="Bold"
                                    FontSize="16"
                                    Foreground="{StaticResource AccentBrush}"
                                    HorizontalAlignment="Right" />
                                <TextBlock
                                    Text="EST. PING"
                                    FontSize="9"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Auto Mode Status Panel (Visible in Auto best mode) -->
                    <Border
                        Grid.Row="3"
                        Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14"
                        Margin="0,0,0,0"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAutoServerSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border
                                Width="42"
                                Height="42"
                                Background="{StaticResource NavActiveBgBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1.5"
                                CornerRadius="21"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,2,0,10"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                                <Border.Effect>
                                    <DropShadowEffect
                                        Color="#00C2FF"
                                        BlurRadius="8"
                                        Opacity="0.35"
                                        ShadowDepth="0" />
                                </Border.Effect>
                                <ui:SymbolIcon
                                    Symbol="Pulse24"
                                    FontSize="18"
                                    Foreground="{StaticResource StatusGoodBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <TextBlock
                                Text="AUTO-ROUTING ACTIVE"
                                FontFamily="/Resources/Fonts/#Rajdhani"
                                FontWeight="Bold"
                                FontSize="14"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                Text="RouteXia monitors all relays and automatically routes your traffic through the lowest latency path."
                                Style="{StaticResource CaptionStyle}"
                                Foreground="{StaticResource TextMutedBrush}"
                                FontSize="11"
                                TextAlignment="Center"
                                LineHeight="16"
                                TextWrapping="Wrap"
                                MaxWidth="320"
                                Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Manual Relay Selection Panel (Visible in Pick relay mode) -->
                    <Grid Grid.Row="3">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsManualServerSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Search Bar -->
                        <Border
                            Grid.Row="0"
                            Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8"
                            Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon
                                    Grid.Column="0"
                                    Symbol="Search24"
                                    FontSize="14"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center" />
                                <TextBox
                                    Grid.Column="1"
                                    Text="{Binding ServerSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="12"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    VerticalContentAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Server List -->
                        <ScrollViewer
                            Grid.Row="1"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredServerNodes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Style="{StaticResource RelayAction}"
                                            Tag="{Binding}"
                                            Click="ServerItem_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Grid.Column="0"
                                                    Width="42"
                                                    Height="42"
                                                    Background="{StaticResource BadgeBgBrush}"
                                                    CornerRadius="8">
                                                    <TextBlock
                                                        Text="{Binding Flag}"
                                                        FontSize="19"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel
                                                    Grid.Column="1"
                                                    Margin="12,0,10,0"
                                                    VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{Binding Name}"
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock
                                                        Text="{Binding Country}"
                                                        Margin="0,3,0,0"
                                                        FontSize="11"
                                                        Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{Binding LatencyDisplayText}"
                                                        FontFamily="/Resources/Fonts/#JetBrains Mono"
                                                        FontSize="14"
                                                        FontWeight="Bold"
                                                        Foreground="{StaticResource StatusGoodBrush}"
                                                        HorizontalAlignment="Right" />
                                                    <TextBlock
                                                        Text="{Binding Region}"
                                                        Margin="0,3,0,0"
                                                        FontSize="10"
                                                        FontWeight="Bold"
                                                        Foreground="{StaticResource TextMutedBrush}"
                                                        HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PageCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Live Routing Stats" Style="{StaticResource PanelTitle}" />
                        <ui:SymbolIcon
                            Grid.Column="1"
                            Symbol="Pulse24"
                            FontSize="20"
                            Foreground="{StaticResource AccentBrush}" />
                    </Grid>

                    <!-- Real-Time Latency Graph (T025-T029) -->
                    <views:LatencyGraphControl
                        Grid.Row="1"
                        RouteHistory="{Binding RouteHistory}"
                        IsConnected="{Binding IsConnected}"
                        MinHeight="180"
                        Margin="0,14,0,14" />

                    <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,10">
                        <Border Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="10,8" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="BEST PING" Style="{StaticResource MutedLabel}" />
                                <TextBlock Text="{Binding BestPingMs, StringFormat={}{0:0} ms}" Margin="0,4,0,0" FontFamily="/Resources/Fonts/#JetBrains Mono" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="10,8" Margin="2,0,2,0">
                            <StackPanel>
                                <TextBlock Text="LOSS" Style="{StaticResource MutedLabel}" />
                                <TextBlock Text="{Binding PacketLoss, StringFormat={}{0:0.0}%}" Margin="0,4,0,0" FontFamily="/Resources/Fonts/#JetBrains Mono" FontSize="16" FontWeight="Bold" Foreground="{StaticResource StatusGoodBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="10,8" Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock Text="UPTIME" Style="{StaticResource MutedLabel}" />
                                <TextBlock Text="{Binding UptimeText}" Margin="0,4,0,0" FontFamily="/Resources/Fonts/#JetBrains Mono" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <StackPanel Grid.Row="3" Margin="0,18,0,0">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="PUBG status"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding GameRunningStatusText}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}" />
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="Packets protected"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding EncryptedPacketsCount}"
                                FontFamily="/Resources/Fonts/#JetBrains Mono"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{StaticResource TextPrimaryBrush}" />
                        </Grid>

                        <Border
                            Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                            <Expander Foreground="{StaticResource TextPrimaryBrush}">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon
                                            Symbol="Settings24"
                                            FontSize="14"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Margin="0,0,8,0" />
                                        <TextBlock
                                            Text="Advanced"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,12,0,0">
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="Local routes first"
                                            FontSize="12"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            VerticalAlignment="Center" />
                                        <ui:ToggleSwitch
                                            Grid.Column="1"
                                            IsChecked="{Binding UseLocalRoutesFirst}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="Redirect login"
                                            FontSize="12"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            VerticalAlignment="Center" />
                                        <ui:ToggleSwitch
                                            Grid.Column="1"
                                            IsChecked="{Binding RedirectLogin}" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="UDP routes"
                                            FontSize="12"
                                            Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding UdpRoutesCount}"
                                            FontFamily="/Resources/Fonts/#JetBrains Mono"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Style="{StaticResource PrimaryAction}"
                IsEnabled="{Binding CanToggleConnection}"
                Background="{Binding ConnectButtonBg}"
                BorderBrush="{Binding ConnectButtonBorder}"
                Foreground="{Binding ConnectButtonFg}"
                Click="BtnConnect_Click">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        Symbol="Power24"
                        FontSize="18"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Margin="0,0,9,0" />
                    <TextBlock
                        Text="{Binding ConnectActionText}"
                        FontFamily="/Resources/Fonts/#Rajdhani"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="2"
                Style="{StaticResource SecondaryAction}"
                Click="BtnReOptimize_Click">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        Symbol="ArrowSync24"
                        FontSize="16"
                        Foreground="{StaticResource AccentBrush}"
                        Margin="0,0,8,0" />
                    <TextBlock
                        Text="Re-test ping"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="4"
                Style="{StaticResource SecondaryAction}"
                Click="BtnLaunchGame_Click">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        Symbol="Play24"
                        FontSize="16"
                        Foreground="{StaticResource StatusGoodBrush}"
                        Margin="0,0,8,0" />
                    <TextBlock
                        Text="Launch PUBG"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
