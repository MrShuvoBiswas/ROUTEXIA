<Page
    x:Class="RouteXia.App.Views.ConnectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="{StaticResource BgBaseBrush}"
    Title="PUBG Boost">

    <Page.Resources>
        <Style x:Key="PageCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="/Resources/Fonts/#Rajdhani" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="MutedLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>

        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#0B121C" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryAction" TargetType="Button">
            <Setter Property="Height" Value="58" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Background" Value="#0D1929" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryAction" TargetType="Button">
            <Setter Property="Height" Value="58" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#0B121C" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RelayAction" TargetType="Button">
            <Setter Property="MinHeight" Value="68" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="#0B121C" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#10283A" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Height="110"
            VerticalAlignment="Top"
            Opacity="0.75"
            IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2616222E" Offset="0" />
                    <GradientStop Color="#241B3847" Offset="0.42" />
                    <GradientStop Color="#22FF3344" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock
                    Text="PUBG BOOST"
                    FontFamily="/Resources/Fonts/#Rajdhani"
                    FontSize="40"
                    FontWeight="Bold"
                    Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock
                    Text="SG relay, live ping, one-click optimize."
                    Margin="0,2,0,0"
                    FontSize="13"
                    Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>

            <Border
                Grid.Column="1"
                MinWidth="156"
                Height="42"
                Padding="14,0"
                VerticalAlignment="Center"
                Background="{Binding ConnectButtonBg}"
                BorderBrush="{Binding ConnectButtonBorder}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse
                        Width="8"
                        Height="8"
                        Fill="{Binding ConnectButtonFg}"
                        Margin="0,0,10,0" />
                    <TextBlock
                        Text="{Binding StateText}"
                        FontFamily="/Resources/Fonts/#Rajdhani"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="{Binding ConnectButtonFg}" />
                </StackPanel>
            </Border>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
            <Border Style="{StaticResource PageCard}" Margin="0,0,12,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="1. SERVER" Style="{StaticResource MutedLabel}" />
                    <TextBlock
                        Text="{Binding SelectedServerName}"
                        Margin="0,7,0,0"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PageCard}" Margin="6,0,6,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="2. LIVE PING" Style="{StaticResource MutedLabel}" />
                    <TextBlock
                        Text="{Binding LivePingText}"
                        Margin="0,7,0,0"
                        FontFamily="/Resources/Fonts/#JetBrains Mono"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PageCard}" Margin="12,0,0,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="3. GAME" Style="{StaticResource MutedLabel}" />
                    <TextBlock
                        Text="PUBG READY"
                        Margin="0,7,0,0"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource StatusGoodBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.28*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.92*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PageCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Server" Style="{StaticResource PanelTitle}" />
                        <Border
                            Grid.Column="1"
                            Padding="9,4"
                            Background="#111F2B"
                            CornerRadius="5">
                            <TextBlock
                                Text="{Binding ServerModeBadgeText}"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </Grid>

                    <UniformGrid Grid.Row="1" Columns="2" Margin="0,16,0,14">
                        <Button Click="BtnSelectAutoMode_Click" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAutoServerSelection}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="#071019" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Symbol="Pulse24"
                                    FontSize="15"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    Margin="0,0,7,0" />
                                <TextBlock
                                    Text="Auto best"
                                    FontWeight="Bold"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>

                        <Button Click="BtnSelectManualMode_Click" Margin="6,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsManualServerSelection}" Value="True">
                                            <Setter Property="Background" Value="#172332" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Symbol="Globe24"
                                    FontSize="15"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    Margin="0,0,7,0" />
                                <TextBlock
                                    Text="Pick relay"
                                    FontWeight="Bold"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <Border
                        Grid.Row="2"
                        Background="#0B121C"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock
                                    Text="{Binding SelectedServerName}"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock
                                    Text="{Binding SelectedServer.Country, TargetNullValue=Waiting for relay}"
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock
                                    Text="{Binding EstimatedPingText}"
                                    FontFamily="/Resources/Fonts/#JetBrains Mono"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource AccentBrush}"
                                    HorizontalAlignment="Right" />
                                <TextBlock
                                    Text="PING"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="3"
                        Background="#0B121C"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                Grid.Column="0"
                                Symbol="Search24"
                                FontSize="14"
                                Foreground="{StaticResource TextMutedBrush}"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center" />
                            <TextBox
                                Grid.Column="1"
                                Text="{Binding ServerSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="12"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                VerticalContentAlignment="Center" />
                        </Grid>
                    </Border>

                    <ScrollViewer
                        Grid.Row="4"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredServerNodes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Style="{StaticResource RelayAction}"
                                        Tag="{Binding}"
                                        Click="ServerItem_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Grid.Column="0"
                                                Width="42"
                                                Height="42"
                                                Background="#111B28"
                                                CornerRadius="8">
                                                <TextBlock
                                                    Text="{Binding Flag}"
                                                    FontSize="19"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="12,0,10,0"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{Binding Name}"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock
                                                    Text="{Binding Country}"
                                                    Margin="0,3,0,0"
                                                    FontSize="11"
                                                    Foreground="{StaticResource TextMutedBrush}" />
                                            </StackPanel>

                                            <StackPanel
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{Binding LatencyDisplayText}"
                                                    FontFamily="/Resources/Fonts/#JetBrains Mono"
                                                    FontSize="14"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource StatusGoodBrush}"
                                                    HorizontalAlignment="Right" />
                                                <TextBlock
                                                    Text="{Binding Region}"
                                                    Margin="0,3,0,0"
                                                    FontSize="10"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource TextMutedBrush}"
                                                    HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PageCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Live" Style="{StaticResource PanelTitle}" />
                        <ui:SymbolIcon
                            Grid.Column="1"
                            Symbol="Pulse24"
                            FontSize="20"
                            Foreground="{StaticResource AccentBrush}" />
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Margin="0,18,0,16"
                        Padding="18"
                        Background="#071018"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock
                                Text="CURRENT PING"
                                Style="{StaticResource MutedLabel}" />
                            <TextBlock
                                Text="{Binding LivePingText}"
                                Margin="0,8,0,0"
                                FontFamily="/Resources/Fonts/#JetBrains Mono"
                                FontSize="42"
                                FontWeight="Bold"
                                Foreground="{StaticResource AccentBrush}" />
                            <TextBlock
                                Text="{Binding RouteXiaServerText}"
                                FontSize="12"
                                Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <UniformGrid Grid.Row="2" Columns="2" Rows="2">
                        <Border Background="#0B121C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="BEST" Style="{StaticResource MutedLabel}" />
                                <TextBlock Text="{Binding BestPingMs, StringFormat={}{0:0} ms}" Margin="0,6,0,0" FontFamily="/Resources/Fonts/#JetBrains Mono" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Background="#0B121C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="8,0,0,8">
                            <StackPanel>
                                <TextBlock Text="LOSS" Style="{StaticResource MutedLabel}" />
                                <TextBlock Text="{Binding PacketLoss, StringFormat={}{0:0.0}%}" Margin="0,6,0,0" FontFamily="/Resources/Fonts/#JetBrains Mono" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Background="#0B121C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,8,0">
                            <StackPanel>
                                <TextBlock Text="ROUTES" Style="{StaticResource MutedLabel}" />
                                <TextBlock Text="{Binding ActiveRoutes}" Margin="0,6,0,0" FontFamily="/Resources/Fonts/#JetBrains Mono" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Background="#0B121C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="8,8,0,0">
                            <StackPanel>
                                <TextBlock Text="UPTIME" Style="{StaticResource MutedLabel}" />
                                <TextBlock Text="{Binding UptimeText}" Margin="0,6,0,0" FontFamily="/Resources/Fonts/#JetBrains Mono" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <StackPanel Grid.Row="3" Margin="0,18,0,0">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="PUBG status"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding GameRunningStatusText}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}" />
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="Packets protected"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding EncryptedPacketsCount}"
                                FontFamily="/Resources/Fonts/#JetBrains Mono"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{StaticResource TextPrimaryBrush}" />
                        </Grid>

                        <Border
                            Background="#0B121C"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                            <Expander Foreground="{StaticResource TextPrimaryBrush}">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon
                                            Symbol="Settings24"
                                            FontSize="14"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Margin="0,0,8,0" />
                                        <TextBlock
                                            Text="Advanced"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,12,0,0">
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="Local routes first"
                                            FontSize="12"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            VerticalAlignment="Center" />
                                        <ui:ToggleSwitch
                                            Grid.Column="1"
                                            IsChecked="{Binding UseLocalRoutesFirst}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="Redirect login"
                                            FontSize="12"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            VerticalAlignment="Center" />
                                        <ui:ToggleSwitch
                                            Grid.Column="1"
                                            IsChecked="{Binding RedirectLogin}" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="UDP routes"
                                            FontSize="12"
                                            Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding UdpRoutesCount}"
                                            FontFamily="/Resources/Fonts/#JetBrains Mono"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Style="{StaticResource PrimaryAction}"
                IsEnabled="{Binding CanToggleConnection}"
                Background="{Binding ConnectButtonBg}"
                BorderBrush="{Binding ConnectButtonBorder}"
                Foreground="{Binding ConnectButtonFg}"
                Click="BtnConnect_Click">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        Symbol="Power24"
                        FontSize="18"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Margin="0,0,9,0" />
                    <TextBlock
                        Text="{Binding ConnectActionText}"
                        FontFamily="/Resources/Fonts/#Rajdhani"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="2"
                Style="{StaticResource SecondaryAction}"
                Click="BtnReOptimize_Click">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        Symbol="ArrowSync24"
                        FontSize="16"
                        Foreground="{StaticResource AccentBrush}"
                        Margin="0,0,8,0" />
                    <TextBlock
                        Text="Re-test ping"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="4"
                Style="{StaticResource SecondaryAction}"
                Click="BtnLaunchGame_Click">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        Symbol="Play24"
                        FontSize="16"
                        Foreground="{StaticResource StatusGoodBrush}"
                        Margin="0,0,8,0" />
                    <TextBlock
                        Text="Launch PUBG"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
