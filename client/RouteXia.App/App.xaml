<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="RouteXia.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ShutdownMode="OnExplicitShutdown">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF-UI theme -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <!-- Our custom styles -->
                <ResourceDictionary Source="Resources/Styles/ColorPalette.xaml" />
                <ResourceDictionary Source="Resources/Styles/SpacingTokens.xaml" />
                <ResourceDictionary Source="Resources/Styles/ButtonStyle.xaml" />
                <ResourceDictionary Source="Resources/Styles/TextStyles.xaml" />
                <ResourceDictionary Source="Resources/Styles/CardStyles.xaml" />
                <ResourceDictionary Source="Resources/Animations/PulseRing.xaml" />
                <ResourceDictionary Source="Resources/Animations/StatusTransitions.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
