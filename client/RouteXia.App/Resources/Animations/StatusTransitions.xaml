<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== RouteXia Status Transition Storyboards ===== -->
    <!--
        Usage in XAML:
          <Border.Triggers>
            <EventTrigger RoutedEvent="Border.Loaded">
              <BeginStoryboard Storyboard="{StaticResource ConnectingSpinnerStoryboard}" />
            </EventTrigger>
          </Border.Triggers>

        Or via DataTrigger EnterActions / ExitActions:
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="ConnectingSB" Storyboard="{StaticResource ConnectingSpinnerStoryboard}" />
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <RemoveStoryboard BeginStoryboardName="ConnectingSB" />
          </DataTrigger.ExitActions>
    -->

    <!-- ── Easing Functions ──────────────────────────────────────────────── -->

    <SineEase x:Key="SineEaseInOut" EasingMode="EaseInOut" />
    <CubicEase x:Key="CubicEaseOut" EasingMode="EaseOut" />
    <PowerEase x:Key="PowerEaseInOut" EasingMode="EaseInOut" Power="2" />

    <!-- ── Connecting State: Rotating Spinner Arc ────────────────────────── -->
    <!--
        Target: RotateTransform named "ConnectingSpinnerRotate" on the arc Path.
        Spins 360° continuously in 1.2 seconds.
    -->
    <Storyboard
        x:Key="ConnectingSpinnerStoryboard"
        RepeatBehavior="Forever">
        <DoubleAnimation
            Storyboard.TargetName="ConnectingSpinnerRotate"
            Storyboard.TargetProperty="Angle"
            From="0"
            To="360"
            Duration="0:0:1.2" />
    </Storyboard>

    <!-- ── Connected State: Glow Pulse Ring ─────────────────────────────── -->
    <!--
        Target: UIElement named "ConnectedGlowEllipse".
        Breathes opacity from 0.4 to 1.0 and back over 3 seconds.
        Represents a calm, alive "heartbeat" while connection is stable.
    -->
    <Storyboard
        x:Key="ConnectedGlowStoryboard"
        RepeatBehavior="Forever"
        AutoReverse="True">
        <DoubleAnimation
            Storyboard.TargetName="ConnectedGlowEllipse"
            Storyboard.TargetProperty="Opacity"
            From="0.4"
            To="1.0"
            Duration="0:0:1.5"
            EasingFunction="{StaticResource SineEaseInOut}" />
    </Storyboard>

    <!-- ── Optimizing State: 3-Dot Chase Pulse ──────────────────────────── -->
    <!--
        Targets: Three Ellipse elements named "OptDot1", "OptDot2", "OptDot3".
        Staggered opacity pulses create a left-to-right "chasing" motion.
        Each dot: active opacity=1.0, rest opacity=0.25
        Total cycle: 600ms, dots staggered by 200ms.
    -->
    <Storyboard
        x:Key="OptimizingPulseStoryboard"
        RepeatBehavior="Forever">

        <!-- Dot 1 (no delay) -->
        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetName="OptDot1"
            Storyboard.TargetProperty="Opacity">
            <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="1.0" />
            <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0.25"
                EasingFunction="{StaticResource SineEaseInOut}" />
            <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0.25" />
        </DoubleAnimationUsingKeyFrames>

        <!-- Dot 2 (200ms delay) -->
        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetName="OptDot2"
            Storyboard.TargetProperty="Opacity">
            <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0.25" />
            <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1.0" />
            <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="0.25"
                EasingFunction="{StaticResource SineEaseInOut}" />
            <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0.25" />
        </DoubleAnimationUsingKeyFrames>

        <!-- Dot 3 (400ms delay) -->
        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetName="OptDot3"
            Storyboard.TargetProperty="Opacity">
            <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0.25" />
            <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0.25" />
            <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="1.0" />
            <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0.25"
                EasingFunction="{StaticResource SineEaseInOut}" />
        </DoubleAnimationUsingKeyFrames>

    </Storyboard>

    <!-- ── State Fade Transition: Generic Cross-Fade ─────────────────────── -->
    <!--
        Utility storyboard to fade in a UI element when a state layer becomes visible.
        Target: any UIElement named "StateLayer" in the triggering scope.
        Duration: 150ms — matches the hover transition budget.
    -->
    <Storyboard x:Key="StateFadeInStoryboard">
        <DoubleAnimation
            Storyboard.TargetProperty="Opacity"
            From="0"
            To="1"
            Duration="0:0:0.15"
            EasingFunction="{StaticResource CubicEaseOut}" />
    </Storyboard>

    <Storyboard x:Key="StateFadeOutStoryboard">
        <DoubleAnimation
            Storyboard.TargetProperty="Opacity"
            From="1"
            To="0"
            Duration="0:0:0.1"
            EasingFunction="{StaticResource CubicEaseOut}" />
    </Storyboard>

</ResourceDictionary>
